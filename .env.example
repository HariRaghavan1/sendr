# Bork - AI Email Outreach Platform
# Environment Variables Template
#
# IMPORTANT: Never commit actual .env files to version control
# Copy this file to .env.local and fill in your actual values

# ============================================================================
# Supabase Configuration
# ============================================================================
# Get these from: https://app.supabase.com/project/_/settings/api

# Your Supabase project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase anonymous (public) key
# This is safe to expose in the frontend
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================================
# Edge Function Secrets (DO NOT put in .env, use Supabase CLI)
# ============================================================================
# Set via: supabase secrets set OPENAI_API_KEY=sk-...

# OpenAI API Key (required for email generation)
# Get from: https://platform.openai.com/api-keys
# Format: sk-...
# OPENAI_API_KEY=sk-...

# ============================================================================
# Development Only
# ============================================================================

# Development mode (optional)
NODE_ENV=development

# Vite dev server port (optional)
VITE_PORT=5173

# ============================================================================
# Production Deployment (GitHub Secrets)
# ============================================================================
# Add these to your GitHub repository secrets
# Settings > Secrets and variables > Actions

# Supabase Access Token
# Get from: https://app.supabase.com/account/tokens
# PRODUCTION_SUPABASE_ACCESS_TOKEN=sbp_...

# Supabase Project Reference
# Get from: https://app.supabase.com/project/_/settings/general
# PRODUCTION_SUPABASE_PROJECT_REF=xxx

# Deployment Token (Vercel/Netlify/etc)
# Get from your deployment platform
# PRODUCTION_DEPLOYMENT_TOKEN=xxx

# ============================================================================
# Optional: Monitoring & Analytics
# ============================================================================

# Sentry DSN (optional, for error tracking)
# Get from: https://sentry.io/settings/projects/
# VITE_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# Sentry Environment
# VITE_SENTRY_ENVIRONMENT=production

# Google Analytics ID (optional)
# VITE_GA_ID=G-XXXXXXXXXX

# ============================================================================
# Optional: Feature Flags
# ============================================================================

# Enable beta features (optional)
# VITE_ENABLE_BETA_FEATURES=false

# Debug mode (optional, for development)
# VITE_DEBUG=false

# ============================================================================
# Notes
# ============================================================================
#
# User API Keys (Clado, Composio):
# - These are NOT environment variables
# - Users configure them in the app's Settings page
# - Stored securely in user_settings table with RLS
#
# Security Best Practices:
# - Never commit .env files to git
# - Use different values for dev/staging/production
# - Rotate secrets regularly
# - Use Supabase secrets for edge function env vars
# - Keep ANON_KEY public-safe (it has RLS protection)
# - Keep SERVICE_ROLE_KEY private (never expose to frontend)
#
# For more information, see:
# - docs/DEPLOYMENT.md
# - docs/SECURITY.md
